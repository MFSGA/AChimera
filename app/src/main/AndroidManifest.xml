<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name="rs.chimera.android.ChimeraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chimera"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name="rs.chimera.android.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Chimera" />
        <activity
            android:name="rs.chimera.android.ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera" />
        <activity-alias
            android:name="rs.chimera.android.MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity="rs.chimera.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name="rs.chimera.android.DialerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <action android:name="android.telephony.action.SECRET_CODE" />
                <data
                    android:host="252746382"
                    android:scheme="android_secret_code" />
            </intent-filter>
        </receiver>
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaMainActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaHelpActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaProfilesDesignActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaProfilePropertiesActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaProfileFilesActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaProvidersActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaNewProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaProxyDesignActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaLogsDesignActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaLogsHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaConnectionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaSettingsHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaOverrideActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <activity
            android:name="rs.chimera.android.ui.metacubex.activity.MetaAccessControlActivity"
            android:exported="false"
            android:theme="@style/Theme.Chimera.MetaCubeX" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_file_paths" />
        </provider>
        <receiver
            android:name="rs.chimera.android.service.VpnRecoveryReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name="rs.chimera.android.backend.ProfileAutoUpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name="rs.chimera.android.service.TunService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="proxy" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>
