<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <ScrollView
        android:id="@+id/remote_profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="?attr/actionBarSize"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <View
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/ic_outline_info" />

                <TextView
                    android:id="@+id/remote_profile_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="17.5dp"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
            </LinearLayout>

            <include
                android:id="@+id/property_name"
                layout="@layout/meta_item_remote_profile_property" />

            <include
                android:id="@+id/property_url"
                layout="@layout/meta_item_remote_profile_property" />

            <include
                android:id="@+id/property_options"
                layout="@layout/meta_item_remote_profile_property" />

            <include
                android:id="@+id/property_auto_update"
                layout="@layout/meta_item_remote_profile_property" />

            <include
                android:id="@+id/property_browse"
                layout="@layout/meta_item_remote_profile_label" />
        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/remote_profile_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:alpha="0.96"
        android:background="?android:attr/windowBackground"
        android:paddingEnd="17.5dp">

        <FrameLayout
            android:id="@+id/toolbar_navigation"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="8.5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:paddingHorizontal="5dp"
                android:src="@drawable/ic_baseline_arrow_back" />
        </FrameLayout>

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/toolbar_navigation"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

        <FrameLayout
            android:id="@+id/remote_profile_save_container"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="17.5dp">

            <ProgressBar
                android:id="@+id/remote_profile_save_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/remote_profile_save"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/save"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/ic_baseline_save" />
        </FrameLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
