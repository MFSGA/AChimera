<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/providers_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/metacubex_toolbar_height"
        android:scrollbars="none" />

    <rs.chimera.android.ui.metacubex.design.view.ActivityBarLayout
        android:id="@+id/providers_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.96"
        android:background="?android:attr/windowBackground">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/metacubex_toolbar_height"
            android:paddingEnd="@dimen/metacubex_item_tailing_margin">

            <LinearLayout
                android:id="@+id/providers_toolbar_content"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/metacubex_toolbar_height"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/providers_update_all"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/providers_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="8.5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:paddingHorizontal="5dp"
                        android:src="@drawable/ic_baseline_arrow_back" />
                </FrameLayout>

                <TextView
                    android:id="@+id/providers_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/meta_providers_title"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
            </LinearLayout>

            <ImageView
                android:id="@+id/providers_update_all"
                android:layout_width="@dimen/metacubex_item_tailing_component_size"
                android:layout_height="@dimen/metacubex_item_tailing_component_size"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/metacubex_item_tailing_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/meta_providers_update_all"
                android:focusable="true"
                android:padding="@dimen/metacubex_toolbar_image_action_padding"
                android:src="@drawable/ic_baseline_sync" />
        </RelativeLayout>
    </rs.chimera.android.ui.metacubex.design.view.ActivityBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
