<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/log_recycler_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/state_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/state_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>

    <rs.chimera.android.ui.metacubex.design.view.ActivityBarLayout
        android:id="@+id/log_activity_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/metacubex_item_tailing_margin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/log_close_button"
                android:gravity="center_vertical"
                android:minHeight="@dimen/metacubex_toolbar_height"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/log_back_button"
                    android:layout_width="@dimen/metacubex_item_header_component_size"
                    android:layout_height="@dimen/metacubex_item_header_component_size"
                    android:layout_marginHorizontal="@dimen/metacubex_item_header_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/meta_logcat_close"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/metacubex_toolbar_image_action_padding"
                    android:src="@drawable/ic_baseline_arrow_back" />

                <TextView
                    android:id="@+id/log_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/meta_logcat_title"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
            </LinearLayout>

            <ImageView
                android:id="@+id/log_close_button"
                android:layout_width="@dimen/metacubex_item_tailing_component_size"
                android:layout_height="@dimen/metacubex_item_tailing_component_size"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/metacubex_item_tailing_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/meta_logcat_close"
                android:focusable="true"
                android:padding="@dimen/metacubex_toolbar_image_action_padding"
                android:src="@drawable/ic_baseline_stop" />
        </RelativeLayout>
    </rs.chimera.android.ui.metacubex.design.view.ActivityBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
