<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/metacubex_toolbar_height"
                android:background="?android:windowBackground"
                android:title="@string/proxy_screen"
                app:navigationIcon="@drawable/ic_baseline_arrow_back"
                app:navigationIconTint="?attr/colorControlNormal"
                app:titleTextColor="?android:attr/textColorPrimary" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/proxy_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_layout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/metacubex_tab_layout_height"
                        android:alpha="0.96"
                        android:background="?android:windowBackground"
                        android:elevation="@dimen/metacubex_tab_layout_elevation"
                        app:tabBackground="@android:color/transparent"
                        app:tabIndicatorColor="?attr/colorPrimary"
                        app:tabMode="scrollable" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/metacubex_divider_size"
                        android:alpha="0.96"
                        android:background="?android:windowBackground"
                        android:elevation="@dimen/metacubex_tab_layout_elevation" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/view_pager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/proxy_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:windowBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ProgressBar
                        android:id="@+id/proxy_state_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:id="@+id/proxy_state_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                    <TextView
                        android:id="@+id/proxy_state_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/proxy_state_retry"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/retry"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_delay_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/metacubex_item_tailing_margin"
            android:contentDescription="@string/proxy_delay_test"
            android:src="@drawable/ic_baseline_flash_on"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="?attr/colorOnPrimary" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
