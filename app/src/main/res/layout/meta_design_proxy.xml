<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/proxy_empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/proxy_empty_tips"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:visibility="gone" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/proxy_activity_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.96"
                android:background="?android:windowBackground"
                android:minHeight="@dimen/metacubex_toolbar_height">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/metacubex_toolbar_height"
                    android:paddingEnd="@dimen/metacubex_item_tailing_margin">

                    <LinearLayout
                        android:id="@+id/proxy_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/proxy_delay_test_action"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/proxy_back_button"
                            android:layout_width="@dimen/metacubex_item_header_component_size"
                            android:layout_height="@dimen/metacubex_item_header_component_size"
                            android:layout_marginHorizontal="@dimen/metacubex_item_header_margin"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/back"
                            android:focusable="true"
                            android:paddingHorizontal="@dimen/metacubex_toolbar_image_action_padding"
                            android:src="@drawable/ic_baseline_arrow_back" />

                        <TextView
                            android:id="@+id/proxy_toolbar_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/proxy_screen"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/proxy_delay_test_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/metacubex_item_tailing_margin"
                        android:layout_toStartOf="@id/proxy_overflow_button">

                        <ImageView
                            android:id="@+id/proxy_delay_test_icon"
                            android:layout_width="@dimen/metacubex_item_tailing_component_size"
                            android:layout_height="@dimen/metacubex_item_tailing_component_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/proxy_delay_test"
                            android:focusable="true"
                            android:padding="@dimen/metacubex_toolbar_image_action_padding"
                            android:src="@drawable/ic_baseline_flash_on" />

                        <ProgressBar
                            android:id="@+id/proxy_delay_test_progress"
                            android:layout_width="@dimen/metacubex_item_tailing_component_size"
                            android:layout_height="@dimen/metacubex_item_tailing_component_size"
                            android:visibility="gone" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/proxy_overflow_button"
                        android:layout_width="@dimen/metacubex_item_tailing_component_size"
                        android:layout_height="@dimen/metacubex_item_tailing_component_size"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/metacubex_item_tailing_margin"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/proxy_more_options"
                        android:focusable="true"
                        android:padding="@dimen/metacubex_toolbar_image_action_padding"
                        android:src="@drawable/ic_baseline_more_vert" />
                </RelativeLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/proxy_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/metacubex_tab_layout_height"
                    android:alpha="0.96"
                    android:background="?android:windowBackground"
                    app:tabBackground="@android:color/transparent"
                    app:tabIndicatorColor="?attr/colorPrimary"
                    app:tabMode="scrollable" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/metacubex_divider_size"
                    android:alpha="0.96"
                    android:background="?android:windowBackground"
                    android:elevation="@dimen/metacubex_tab_layout_elevation" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/proxy_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/metacubex_toolbar_height"
            android:background="?android:windowBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/proxy_state_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/proxy_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

            <TextView
                android:id="@+id/proxy_state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/proxy_state_retry"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/retry"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_delay_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/metacubex_item_tailing_margin"
            android:contentDescription="@string/proxy_delay_test"
            android:src="@drawable/ic_baseline_flash_on"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="?attr/colorOnPrimary" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
