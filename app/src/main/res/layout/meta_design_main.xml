<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="self"
            type="rs.chimera.android.ui.metacubex.design.MainDesign" />
        <variable
            name="mode"
            type="String" />
        <variable
            name="profileName"
            type="String" />
        <import type="android.view.View" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/metacubex_main_horizontal_padding"
                android:paddingEnd="@dimen/metacubex_main_horizontal_padding"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/metacubex_main_banner_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/metacubex_main_icon_slot"
                        android:layout_height="@dimen/metacubex_main_icon_slot">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_launcher_foreground" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
                </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/metacubex_main_card_min_height"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginVertical="@dimen/metacubex_main_card_margin_vertical"
            app:cardBackgroundColor="@color/clash_stopped"
            app:cardCornerRadius="@dimen/metacubex_main_card_radius"
            app:cardElevation="@dimen/metacubex_main_card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/metacubex_main_icon_slot"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/icon_status"
                        android:layout_width="@dimen/metacubex_main_icon_size"
                        android:layout_height="@dimen/metacubex_main_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_not_interested"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/metacubex_main_label_padding_vertical">

                <TextView
                    android:id="@+id/text_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_vpn_stopped"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/text_status_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/metacubex_main_label_margin_vertical"
                    android:text="@string/stat_vpn_hint_start"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_proxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/metacubex_main_card_min_height"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginVertical="@dimen/metacubex_main_card_margin_vertical"
            app:cardCornerRadius="@dimen/metacubex_main_card_radius"
            app:cardElevation="@dimen/metacubex_main_card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/metacubex_main_icon_slot"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/metacubex_main_icon_size"
                        android:layout_height="@dimen/metacubex_main_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_baseline_apps" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/metacubex_main_label_padding_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_screen"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

                    <TextView
                        android:id="@+id/text_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/metacubex_main_label_margin_vertical"
                        android:text="@{mode}"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/metacubex_main_card_min_height"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginVertical="@dimen/metacubex_main_card_margin_vertical"
            app:cardCornerRadius="@dimen/metacubex_main_card_radius"
            app:cardElevation="@dimen/metacubex_main_card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/metacubex_main_icon_slot"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/metacubex_main_icon_size"
                        android:layout_height="@dimen/metacubex_main_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_baseline_view_list" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/metacubex_main_label_padding_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_screen"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

                <TextView
                    android:id="@+id/text_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/metacubex_main_label_margin_vertical"
                    android:text="@{profileName}"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/card_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="15dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_baseline_assignment" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logs_screen"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="15dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_baseline_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_screen"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="15dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_baseline_help_center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cmfa_help_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="15dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_baseline_info" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_connections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="15dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_baseline_swap_horiz" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connections_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="15dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_baseline_memory" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_memory"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

                <TextView
                    android:id="@+id/text_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/not_available"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_open_watfaq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="15dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_baseline_link" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switch_to_watfaq_ui"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
        </LinearLayout>
        </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
