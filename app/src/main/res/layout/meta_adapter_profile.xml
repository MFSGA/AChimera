<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="android.view.View" />

        <variable
            name="profileName"
            type="String" />
        <variable
            name="profileType"
            type="String" />
        <variable
            name="lastUpdatedText"
            type="String" />
        <variable
            name="subscriptionUsageText"
            type="String" />
        <variable
            name="subscriptionExpireText"
            type="String" />
        <variable
            name="subscriptionProgressVisible"
            type="boolean" />
        <variable
            name="subscriptionProgress"
            type="int" />
        <variable
            name="isActive"
            type="boolean" />
        <variable
            name="clicked"
            type="android.view.View.OnClickListener" />
        <variable
            name="menu"
            type="android.view.View.OnClickListener" />
    </data>

    <RelativeLayout
        android:id="@+id/profile_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17.5dp"
        android:layout_marginVertical="5dp"
        android:background="@drawable/meta_profile_card_background"
        android:clickable="true"
        android:elevation="5dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:minHeight="75dp"
        android:nextFocusRight="@id/menu_view"
        android:onClick="@{clicked}">

        <RadioButton
            android:id="@+id/icon_view"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="17.5dp"
            android:checked="@{isActive}"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/elapsed_view"
            android:layout_toEndOf="@id/icon_view"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{profileName}"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@{profileType}"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:visibility="@{profileType != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:id="@+id/text_profile_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_profile_subscription_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{subscriptionUsageText}"
                android:textSize="12sp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_profile_subscription_expire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{subscriptionExpireText}"
                android:textSize="12sp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:visibility="gone" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="@{subscriptionProgress}"
                android:visibility="@{subscriptionProgressVisible ? View.VISIBLE : View.GONE}" />
        </LinearLayout>

        <TextView
            android:id="@+id/elapsed_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@id/menu_view"
            android:text="@{lastUpdatedText}"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Tooltip"
            android:visibility="@{lastUpdatedText != null ? View.VISIBLE : View.GONE}" />

        <View
            android:id="@+id/profile_active_indicator"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/menu_view"
            android:background="@color/metacubex_primary_dark" />

        <FrameLayout
            android:id="@+id/menu_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/profile_menu_content_description"
            android:focusable="true"
            android:nextFocusLeft="@id/profile_root"
            android:onClick="@{menu}">

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="17.5dp"
                android:background="@drawable/ic_baseline_more_vert" />
        </FrameLayout>
    </RelativeLayout>
</layout>
