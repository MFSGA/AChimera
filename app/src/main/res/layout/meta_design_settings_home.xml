<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="?attr/actionBarSize"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/category_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="17.5dp"
                    android:background="@drawable/ic_baseline_settings" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_category_app"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/category_network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="17.5dp"
                    android:background="@drawable/ic_baseline_dns" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_category_network"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/category_override"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="17.5dp"
                    android:background="@drawable/ic_baseline_extension" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_category_override"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/category_meta_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="75dp"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="17.5dp"
                    android:background="@drawable/ic_baseline_meta" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_category_meta_features"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:alpha="0.96"
        android:background="?android:attr/windowBackground"
        android:clickable="true"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        android:paddingEnd="17.5dp">

        <ImageView
            android:id="@+id/toolbar_navigation"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="17.5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:paddingHorizontal="5dp"
            android:src="@drawable/ic_baseline_arrow_back" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/settings_screen"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
