<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/metacubex_toolbar_height"
        android:scrollbars="none" />

    <FrameLayout
        android:id="@+id/state_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/state_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_selector_empty"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_load"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/retry"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.96"
        android:background="?android:attr/windowBackground"
        android:clickable="true"
        android:elevation="0dp"
        android:importantForAccessibility="no">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/metacubex_toolbar_height"
            android:layout_gravity="bottom"
            android:paddingEnd="@dimen/metacubex_item_tailing_margin">

        <LinearLayout
            android:id="@+id/activity_bar_title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/access_control_search_button"
            android:gravity="center_vertical"
            android:minHeight="@dimen/metacubex_toolbar_height"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/toolbar_back"
                android:layout_width="@dimen/metacubex_item_header_component_size"
                android:layout_height="@dimen/metacubex_item_header_component_size"
                android:layout_marginHorizontal="@dimen/metacubex_item_header_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/access_control_back"
                android:focusable="true"
                android:paddingHorizontal="@dimen/metacubex_toolbar_image_action_padding"
                android:src="@drawable/ic_baseline_arrow_back" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/access_control_packages"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/access_control_search_button"
            android:layout_width="@dimen/metacubex_item_tailing_component_size"
            android:layout_height="@dimen/metacubex_item_tailing_component_size"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/metacubex_item_tailing_margin"
            android:layout_toStartOf="@id/access_control_menu_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/app_selector_search"
            android:focusable="true"
            android:padding="@dimen/metacubex_toolbar_image_action_padding"
            android:src="@drawable/ic_baseline_search" />

        <ImageView
            android:id="@+id/access_control_menu_button"
            android:layout_width="@dimen/metacubex_item_tailing_component_size"
            android:layout_height="@dimen/metacubex_item_tailing_component_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/metacubex_item_tailing_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/access_control_options"
            android:focusable="true"
            android:padding="@dimen/metacubex_toolbar_image_action_padding"
            android:src="@drawable/ic_baseline_more_vert" />
        </RelativeLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
