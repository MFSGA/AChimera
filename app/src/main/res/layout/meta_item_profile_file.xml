<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/metacubex_item_min_height"
    android:nextFocusRight="@id/profile_file_more">

    <ImageView
        android:id="@+id/profile_file_icon"
        android:layout_width="@dimen/metacubex_item_tailing_component_size"
        android:layout_height="@dimen/metacubex_item_tailing_component_size"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/metacubex_item_header_margin"
        android:contentDescription="@null"
        android:src="@drawable/ic_outline_article" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/profile_file_modified"
        android:layout_toEndOf="@id/profile_file_icon"
        android:orientation="vertical"
        android:paddingVertical="@dimen/metacubex_item_padding_vertical">

        <TextView
            android:id="@+id/profile_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

        <TextView
            android:id="@+id/profile_file_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metacubex_item_text_margin"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
    </LinearLayout>

    <View
        android:id="@+id/profile_file_divider"
        android:layout_width="@dimen/metacubex_divider_size"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/profile_file_more"
        android:background="?attr/colorControlHighlight"
        android:minHeight="@dimen/metacubex_item_divider_height" />

    <TextView
        android:id="@+id/profile_file_modified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/metacubex_item_middle_margin"
        android:layout_toStartOf="@id/profile_file_divider"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Tooltip" />

    <FrameLayout
        android:id="@+id/profile_file_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:nextFocusLeft="@id/root_view">

        <ImageView
            android:layout_width="@dimen/metacubex_item_tailing_component_size"
            android:layout_height="@dimen/metacubex_item_tailing_component_size"
            android:layout_margin="@dimen/metacubex_item_tailing_margin"
            android:contentDescription="@string/access_control_options"
            android:src="@drawable/ic_baseline_more_vert" />
    </FrameLayout>
</RelativeLayout>
